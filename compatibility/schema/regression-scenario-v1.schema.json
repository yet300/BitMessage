{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bitmessage.local/schemas/regression-scenario-v1.json",
  "title": "BitMessage deferred regression scenario manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "profile", "scenarios"],
  "properties": {
    "formatVersion": { "const": 1 },
    "profile": { "type": "string", "minLength": 1 },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "targetPhase", "status", "provenance", "given", "when", "then"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "targetPhase": { "type": "string", "minLength": 1 },
          "status": { "const": "DEFERRED_UNTIL_PRODUCTION_COMPONENT_EXISTS" },
          "provenance": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sourceRepository", "sourceCommitSha", "sourcePath", "sourceTest"],
            "properties": {
              "sourceRepository": { "type": "string", "minLength": 1 },
              "sourceCommitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
              "sourcePath": { "type": "string", "minLength": 1 },
              "sourceTest": { "type": "string", "minLength": 1 }
            }
          },
          "given": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "when": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "then": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        }
      }
    }
  }
}
